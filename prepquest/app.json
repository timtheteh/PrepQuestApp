{
  "expo": {
    "name": "PrepQuest",
    "slug": "prepquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appIcons/ios-light.png",
    "scheme": "prepquest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.prepquest",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture images for creating flashcards",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to select images for creating flashcards",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record audio for flashcards",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/appIcons/ios-light.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcons/adaptive-icon3.png",
        "backgroundColor": "#44B88A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.prepquest"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/appIcons/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio",
      "expo-web-browser",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#44B88A"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "af520b40-2d10-47dd-86c0-ba1fe338d076"
      }
    },
    "owner": "timothyteh21"
  }
}
